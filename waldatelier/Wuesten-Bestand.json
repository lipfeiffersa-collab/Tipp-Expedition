  "funds": {
    "wald": [
      [
        "feuerstein",
        "Feuerstein",
        "Feuerstein besteht aus Chalcedon, einer Form von Siliciumdioxid. In der Steinzeit machte man daraus scharfe Werkzeuge. Funken gibt er nur zusammen mit Pyrit oder Stahl."
      ],
      [
        "schnecke",
        "Schneckenhaus",
        "Das Gehäuse der Weinbergschnecke besteht aus Kalk. Es ist spiralförmig gewunden, meist rechtsherum."
      ],
      [
        "feder",
        "Feder",
        "Eine fertige Vogelfeder besteht aus toten, verhornten Zellen der Haut."
      ],
      [
        "eichel",
        "Eichel",
        "Der Eichelhäher vergräbt im Herbst Eicheln, bis zu 5.000 Stück. Viele findet er nicht wieder. Aus ihnen wachsen neue Eichen."
      ],
      [
        "zapfen",
        "Zapfen",
        "Zapfen am Waldboden sind meist Fichtenzapfen. Sie hängen am Baum und fallen später ganz herunter. Tannenzapfen stehen aufrecht und zerfallen schon am Zweig."
      ]
    ],
    "hoehle": [
      [
        "amethyst",
        "Amethyst-Druse",
        "Amethyst ist violetter Quarz. Die Farbe kommt von Spuren von Eisen im Kristall. Er wächst oft in Hohlräumen im Gestein, den Drusen. In Deutschland wurde Amethyst bei Idar-Oberstein abgebaut."
      ],
      [
        "opal",
        "Opal",
        "Opal besteht aus winzigen Kügelchen aus Kieselsäure mit Wasser dazwischen. Sie zerlegen das Licht in Regenbogenfarben. Fast alle Edelopale der Welt kommen aus Australien."
      ],
      [
        "diamant",
        "Diamant",
        "Diamanten entstehen in etwa 150 Kilometern Tiefe im Erdmantel, bei 1.200 bis 1.400 °C. Vulkanschlote aus Kimberlit haben sie in wenigen Stunden nach oben gebracht. Dort baut man sie in Minen ab."
      ]
    ],
    "wueste": [
      [
        "sandrose",
        "Sandrose",
        "Rosettenförmiges Gebilde aus Sandkörnern und Gips oder Baryt. Es entsteht, wenn in der Wüste Grundwasser verdunstet und die gelösten Salze auskristallisieren."
      ],
      [
        "haizahn",
        "Fossiler Haifischzahn",
        "Der versteinerte Zahn eines Hais. In Marokko findet man solche Zähne zum Beispiel bei Khouribga. Sie stammen aus der Kreidezeit und dem Tertiär. Haie leben im Meer, hier war also einmal Meer."
      ],
      [
        "ammonit",
        "Ammonit",
        "Das versteinerte, spiralige Gehäuse eines Tieres, das mit den Tintenfischen verwandt war. Im Anti-Atlas in Marokko findet man Ammoniten aus dem Devon, einer sehr alten Erdzeit."
      ],
      [
        "trilobit",
        "Trilobit",
        "Ein versteinerter Gliederfüßer aus dem Urmeer. Sein Panzer ist der Länge nach in drei Teile gegliedert, daher der Name. In Südost-Marokko findet man Trilobiten aus dem Devon."
      ],
      [
        "fulgurit",
        "Fulgurit",
        "Ein „versteinerter Blitz“. Schlägt ein Blitz in Sand, schmelzen die Quarzkörner entlang des Blitzes zu einer Röhre aus Glas. Dafür reichen etwa 1.800 bis 2.950 °C."
      ],
      [
        "wuestenglas",
        "Libysches Wüstenglas",
        "Honiggelbes Glas, etwa 28 bis 30 Millionen Jahre alt. Es entstand vermutlich durch einen Meteoriteneinschlag. Der Skarabäus auf einer Brustplatte von Tutanchamun ist aus diesem Glas geschliffen."
      ],
      [
        "meteorit",
        "Meteorit",
        "Ein Stein aus dem All. Die meisten Meteoriten sind dunkel. Auf hellem Wüstenboden sieht man sie deshalb schon mit bloßem Auge."
      ]
    ],
    "stadt": [
      [
        "flaschenschiff",
        "Schiff in der Flasche",
        "Masten und Takelage des kleinen Schiffs lassen sich umklappen. Nur so passt das Modell durch den Flaschenhals. In der Flasche werden die Masten von außen mit Werkzeug aufgerichtet."
      ],
      [
        "teekanne",
        "Teekanne",
        "In Marokko trinkt man grünen Tee mit frischer Minze und viel Zucker. Man gießt ihn in hohem Bogen ins Glas und wieder zurück in die Kanne, bis sich Schaum bildet."
      ],
      [
        "tonschale",
        "Tonschale",
        "Bemalte Keramik. Die Hafenstadt Safi in Marokko ist für ihre Keramik bekannt."
      ],
